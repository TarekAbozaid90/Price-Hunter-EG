# Collector reads environment variables; never put these into VITE_*.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public frontend settings ONLY, optionally for local dev.
VITE_REPOSITORY=
VITE_DATA_URL=
# Email alerts (SMTP). EMAIL_TO accepts several addresses separated by commas.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_STARTTLS=1
# WhatsApp Business Cloud API alerts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
